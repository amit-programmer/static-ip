# ==========================================
# Delta Exchange Configuration
# ==========================================
# Delta Exchange API URLs:
# - India Testnet / Demo: https://cdn-ind.testnet.deltaex.org
# - India Live:           https://api.india.delta.exchange
# - Global Live:          https://api.delta.exchange
# - Global Testnet:       https://testnet-api.delta.exchange
DELTA_BASE_URL=https://cdn-ind.testnet.deltaex.org
DELTA_API_KEY=your_delta_api_key_here
DELTA_API_SECRET=your_delta_api_secret_here

# ==========================================
# Outbound Static Proxy Configuration (Webshare)
# ==========================================
PROXY_HOST=45.38.107.97
PROXY_PORT=6014
PROXY_USERNAME=your_proxy_username
PROXY_PASSWORD=your_proxy_password
PROXY_AUTH=Basic your_base64_encoded_auth_here

# Python Requests Proxy URLs
HTTP_PROXY=http://username:password@45.38.107.97:6014
HTTPS_PROXY=http://username:password@45.38.107.97:6014

# ==========================================
# Ngrok Upstream Configuration (Optional)
# ==========================================
TARGET_UPSTREAM_URL=https://your-tunnel.ngrok-free.dev
NGROK_URL=https://your-tunnel.ngrok-free.dev
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
